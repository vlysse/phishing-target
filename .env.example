# Turso (target-mfa-vxuom) — the MFA-hardened target database.
DATABASE_URL=libsql://target-mfa-vxuom.aws-ap-south-1.turso.io
DATABASE_AUTH_TOKEN=

# Signs session JWTs. Generate a long random value per environment.
JWT_SECRET=

# Cookie/session lifetime, in seconds.
SESSION_TTL_SECONDS=3600

# Comma-separated origins allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:5174

# Cookie domain (blank for localhost).
COOKIE_DOMAIN=

PORT=4001

# Resend — sends the 6-digit OTP email. Get a key at resend.com.
# RESEND_FROM must use a domain verified in your Resend account (a verified
# domain can send to any recipient). onboarding@resend.dev only delivers to the
# account owner's own email.
RESEND_API_KEY=
RESEND_FROM=TDVX Banking <security@tdvx.site>

# Where the OTP email's "Open verification page" button links to (the MFA
# frontend). Local dev default below; set to the deployed FE URL in prod.
APP_URL=http://localhost:5174

# Public URL used for the email verify button (never localhost - that is a
# spam trigger). Set to the deployed MFA app URL.
PUBLIC_APP_URL=https://app.tdvx.site
RESEND_REPLY_TO=support@tdvx.site
