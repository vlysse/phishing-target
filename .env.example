# Local dev default (file-based libsql). Point this at a Turso URL in staging/prod.
# drizzle-kit's turso dialect requires DATABASE_AUTH_TOKEN to be non-empty even
# for a local file db; any placeholder value works (it's ignored by libsql in
# file mode). Set a real Turso auth token in staging/prod.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=local-dev-unused

# Signs session JWTs. Generate a long random value per environment.
JWT_SECRET=

# Cookie/session lifetime, in seconds.
SESSION_TTL_SECONDS=3600

# Comma-separated list of origins allowed to call this API with credentials
# (the deployed frontend domain, plus http://localhost:5173 for dev).
ALLOWED_ORIGINS=http://localhost:5173

# Domain the session cookie is scoped to (e.g. .tdvxbank.com so both the FE
# and API subdomains can read it). Leave blank for localhost dev.
COOKIE_DOMAIN=

PORT=4000

# Where /auth/session-bootstrap redirects the browser after accepting a
# harvested token (the deployed frontend's dashboard URL).
FRONTEND_URL=http://localhost:5173

